# Azure Blob Storage Configuration
# Get your connection string from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=

# Container name for storing files (will be created automatically if it doesn't exist)
AZURE_CONTAINER_NAME=

# Private container for SQLite database backups (default: pdf-stories-backups)
AZURE_BACKUP_CONTAINER_NAME=

# How many database backups to keep in Azure; older ones are deleted (default: 10)
DB_BACKUP_KEEP=

# Where Logs will be stored
DEBUG_LOG_PATH=